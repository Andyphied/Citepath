# AtlasOps AI — copy to .env and fill in values (never commit .env)

# --- Required ---
# Sync driver (psycopg2) for SQLAlchemy + Alembic. asyncpg deferred post-MVP.
# Use host `postgres` / `redis` when connecting from Docker Compose services.
DATABASE_URL=postgresql+psycopg2://atlasops:atlasops@localhost:5432/atlasops
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# Document storage: local (dev) or s3 (cloud)
STORAGE_BACKEND=local
# Local upload directory (used when STORAGE_BACKEND=local)
STORAGE_PATH=/uploads

# LLM provider: openai or anthropic
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Required when STORAGE_BACKEND=s3 ---
# S3_BUCKET=
# AWS_REGION=eu-west-1

# --- Optional (defaults shown) ---
JWT_EXPIRY_HOURS=24
EMBEDDING_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
RETRIEVAL_MIN_SCORE=0.72
MAX_UPLOAD_BYTES=20971520
LOG_LEVEL=INFO
ENVIRONMENT=development
# Celery worker structured heartbeat interval (OBS-007; default 5 minutes).
# Compose interpolates these into api + worker when set in .env / shell.
# WORKER_HEARTBEAT_INTERVAL_SECONDS=300
# Redis list / Celery queue name used for /health/ready queue_depth
# (must match Celery task_default_queue; default celery).
# CELERY_DEFAULT_QUEUE=celery
# Browser origins for the Next.js app (UI-001). Empty in development → localhost:3000.
# CORS_ORIGINS=http://localhost:3000
